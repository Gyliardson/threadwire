{
  "name": "threadwire",
  "version": "0.1.0",
  "private": true,
  "description": "Threadwire Controller MVP",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/unit/**/*.test.ts",
    "test:acceptance": "tsx --test --test-concurrency=1 tests/acceptance/**/*.acceptance.test.ts",
    "test:acceptance:m7": "tsx --test tests/acceptance/M7_TrueColdStartStreaming.acceptance.test.ts",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
